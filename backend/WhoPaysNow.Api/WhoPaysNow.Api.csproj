<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runs the ASP.NET Core minimal API on the managed `dotnet10` Lambda
         runtime (handler = assembly name). Framework-dependent publish keeps
         the deployment package small; the managed runtime supplies .NET + ICU. -->
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer.Hosting" Version="1.8.0" />
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="4.0.3" />
  </ItemGroup>

</Project>
